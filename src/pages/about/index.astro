---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContributions, allMergedUrl, GH_USER } from '../../utils/contributions';

// Repo-wide numbers come from GitHub at build time (see utils/contributions.ts);
// the PRs below are a hand-picked selection, not the full list.
const { counts, updatedAt, source } = await getContributions();

const openSource = [
  {
    repo: 'The-PR-Agent/pr-agent',
    note: 'AI-powered code review · command handling, diff chunk reuse and token budgets',
    prs: [
      { number: 3011, title: 'feat(github): trigger commands after submitted reviews', date: '2026.09' },
      { number: 3291, title: 'perf(review): reuse prepared diff chunks', date: '2026.09' },
      { number: 2862, title: 'fix(ask-line): enforce conversation history token budget', date: '2026.08' },
      { number: 2993, title: 'feat(codecommit): review all pull request targets', date: '2026.09' },
    ],
  },
  {
    repo: 'k8sgpt-ai/k8sgpt',
    note: 'Kubernetes diagnostics · removing false positives from health reports',
    prs: [
      { number: 1740, title: 'fix: report Deployment ProgressDeadlineExceeded when replica counts still match', date: '2026.08' },
      { number: 1725, title: 'fix: skip failure report for jobs that completed successfully after retries', date: '2026.08' },
      { number: 1737, title: 'fix: inspect Gateway Accepted and Programmed by type', date: '2026.08' },
    ],
  },
  {
    repo: 'ag2ai/ag2',
    note: 'Multi-agent framework · making streaming retries observable',
    prs: [
      { number: 3216, title: 'fix(middleware): stop retries after streaming chunks', date: '2026.09' },
    ],
  },
  {
    repo: 'kubevela/kubevela',
    note: 'Cloud-native applications · admission validation',
    prs: [
      { number: 7303, title: 'Fix: enforce TraitDefinition conflictsWith at admission', date: '2026.08' },
    ],
  },
];

const totalMerged = Object.values(counts).reduce((sum, n) => sum + n, 0);
const repoCount = Object.keys(counts).length;
const synced = `${updatedAt.getFullYear()}.${String(updatedAt.getMonth() + 1).padStart(2, '0')}`;

const elsewhere = [
  { label: 'GitHub', href: `https://github.com/${GH_USER}` },
  { label: 'Email', href: 'mailto:3373484735@qq.com' },
];
---

<BaseLayout
  title="About · junnhwan"
  description="About junnhwan — CS student at Shenzhen University, building full-stack apps and AI agents."
>
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 py-12">
    <header class="profile" data-reveal>
      <img
        src="/avatar.png"
        alt="junnhwan"
        class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover border border-line shrink-0"
        loading="eager"
      />
      <div class="min-w-0">
        <div class="flex flex-wrap items-baseline justify-center gap-x-3 gap-y-1">
          <h1 class="text-[30px] sm:text-[36px] font-semibold text-fg leading-tight">hwan</h1>
          <span class="font-mono text-[13px] text-fg-subtle">@{GH_USER}</span>
        </div>
        <p class="tagline mt-2 text-fg-muted">
          Building full-stack apps and AI agents.
        </p>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
          {
            elsewhere.map((item) => (
              <a
                href={item.href}
                target={item.href.startsWith('http') ? '_blank' : undefined}
                rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="h-9 px-4 inline-flex items-center rounded-full pill text-[13px] text-fg-muted"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <section class="about-body" data-reveal data-reveal-delay="60">
      <p>
        I'm <span class="text-fg">Junnhwan</span>, majoring in Computer Science at Shenzhen
        University (Class of 2028).
      </p>
      <p>
        Most of my time goes into full-stack apps and AI agents. Working mostly in
        <span class="font-mono text-[0.92em] text-fg">Go</span>,
        <span class="font-mono text-[0.92em] text-fg">Java</span>,
        <span class="font-mono text-[0.92em] text-fg">Python</span> and
        <span class="font-mono text-[0.92em] text-fg">TypeScript</span>.
      </p>
      <p class="text-fg-subtle">Open to full-stack &amp; AI agent internships.</p>
    </section>

    <!-- Everything above is centred; this rule marks where the page switches to
         a left-aligned reading column for the contribution list. -->
    <hr class="section-rule" data-reveal data-reveal-delay="90" />

    <section data-reveal data-reveal-delay="120">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.12em] text-fg-subtle">
          Selected Contributions
        </h2>
        <span class="font-mono text-[11px] text-fg-subtle">
          {totalMerged} merged across {repoCount} repos since 2026.08
        </span>
      </div>

      <div class="mt-8 border-t border-line">
        {
          openSource.map((repo) => {
            const repoUrl = `https://github.com/${repo.repo}`;
            const count = counts[repo.repo];
            return (
              <article class="py-6 border-b border-line">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="text-sm font-semibold text-fg">
                    <a
                      href={repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link inline-flex max-w-full items-baseline gap-2 font-mono"
                    >
                      <span class="min-w-0 break-words">{repo.repo}</span>
                      <span aria-hidden="true" class="shrink-0 text-accent">↗</span>
                    </a>
                  </h3>
                  {count !== undefined && (
                    <span
                      class="font-mono text-[11px] text-fg-subtle tabular-nums"
                      title={`Read from GitHub on ${synced}`}
                    >
                      {count} merged in total
                    </span>
                  )}
                </div>
                <p class="mt-1.5 text-[13px] leading-relaxed text-fg-muted">{repo.note}</p>
                <ul class="mt-4 space-y-0.5">
                  {repo.prs.map((pr) => (
                    <li>
                      <a
                        href={`${repoUrl}/pull/${pr.number}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="pr-link grid grid-cols-[3.5rem_minmax(0,1fr)_auto] gap-2 rounded-md px-2 py-2 -mx-2 text-[13px] leading-relaxed"
                      >
                        <span class="font-mono text-accent">#{pr.number}</span>
                        <span>{pr.title}</span>
                        <time class="font-mono text-[11px] text-fg-subtle tabular-nums">
                          {pr.date}
                        </time>
                      </a>
                    </li>
                  ))}
                </ul>
                <a
                  href={allMergedUrl(repo.repo)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link mt-3 inline-flex items-center gap-1.5 text-[12px] text-accent"
                >
                  All in {repo.repo.split('/')[1]} <span aria-hidden="true">↗</span>
                </a>
              </article>
            );
          })
        }
      </div>

      <p class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-[11px] text-fg-subtle">
        <a
          href={allMergedUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="link text-accent">All merged contributions ↗</a
        >
        <span title={updatedAt.toISOString()}>
          counts synced {synced}{source === 'fallback' && ' · GitHub unreachable, showing cached values'}
        </span>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  /* Sits between --fg and --fg-muted so the name block reads as the page title
     instead of fading into the background it shares a tone with. */
  .tagline {
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.6;
  }

  /* No measure limit: the bio is a few short sentences, and capping the width
     only broke them across lines that had room to fit. Centred to line up with
     the profile block above it. */
  .about-body {
    margin-top: 2.25rem;
    font-size: 16px;
    line-height: 1.95;
    color: var(--fg);
    text-align: center;
  }

  .about-body > * + * {
    margin-top: 1rem;
  }

  /* Deliberately heavier than the hairline rules inside the section: this one
     has to read as the boundary between two layouts, not as a row divider. */
  .section-rule {
    height: 0;
    margin-top: 3.5rem;
    border: 0;
    border-top: 1px solid var(--line-strong);
  }

  .link {
    text-underline-offset: 4px;
    transition: color var(--dur-fast) var(--ease);
  }

  .link:hover,
  .link:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }

  .pr-link {
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .pr-link:hover,
  .pr-link:focus-visible {
    background-color: var(--surface-hover);
    color: var(--fg);
  }

  @media (max-width: 639px) {
    .profile {
      gap: 1rem;
    }

    .pr-link {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    .pr-link time {
      display: none;
    }
  }
</style>
