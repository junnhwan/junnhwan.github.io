---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Selected merged contributions, verified on GitHub on 2026-09-05.
const repos = [
  {
    name: 'The-PR-Agent / pr-agent',
    url: 'https://github.com/The-PR-Agent/pr-agent',
    description: 'AI-powered code review · Agent capabilities and reliable review workflows',
    prs: [
      { number: 3011, title: 'Trigger PR-Agent commands from submitted GitHub reviews' },
      { number: 2993, title: 'Review every CodeCommit target and route suggestions to the correct comparison' },
      { number: 2967, title: 'Bring configured Agent Skills into top-level /ask prompts' },
      { number: 2862, title: 'Enforce conversation token budgets across primary and fallback models' },
      { number: 2829, title: 'Keep successful code suggestions when individual diff chunks fail' },
    ],
  },
  {
    name: 'k8sgpt-ai / k8sgpt',
    url: 'https://github.com/k8sgpt-ai/k8sgpt',
    description: 'Kubernetes diagnostics · More accurate workload and resource analysis',
    prs: [
      { number: 1740, title: 'Detect timed-out Deployment rollouts even when replica counts match' },
      { number: 1737, title: 'Evaluate Gateway Accepted and Programmed conditions by type' },
      { number: 1725, title: 'Avoid false failure reports for Jobs that succeed after retries' },
    ],
  },
  {
    name: 'kubevela / kubevela',
    url: 'https://github.com/kubevela/kubevela',
    description: 'Cloud-native applications · Admission validation',
    prs: [
      { number: 7303, title: 'Reject conflicting traits during Application admission' },
    ],
  },

];
---

<BaseLayout
  title="About · junnhwan"
  description="About junnhwan — CS student at Shenzhen University, full-stack & AI agent developer in the making."
>
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 py-12 grid items-start gap-12 lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-20">
    <aside class="space-y-8 lg:sticky lg:top-28 min-w-0">
    <header class="flex items-center gap-4" data-reveal>
      <img
        src="/avatar.png"
        alt="junnhwan"
        class="w-14 h-14 rounded-full object-cover border border-line"
        loading="eager"
      />
      <div class="min-w-0">
        <div class="flex items-baseline gap-2.5">
          <h1 class="text-xl font-semibold text-fg">hwan</h1>
          <span class="font-mono text-xs text-fg-subtle">@junnhwan</span>
        </div>
        <p class="mt-0.5 text-[13px] text-fg-muted">
          Full-stack &amp; AI Agent developer in the making.
        </p>
      </div>
    </header>

    <section class="space-y-4 text-[14px] leading-[1.9]" data-reveal data-reveal-delay="60">
      <p>
        I'm <span class="text-fg">Junnhwan</span>, majoring in Computer Science at Shenzhen
        University (Class of 2028).
      </p>
      <p>
        Building full-stack apps, and diving into AI agents. Working mostly in
        <span class="font-mono text-[13px] text-fg">Go</span>,
        <span class="font-mono text-[13px] text-fg">Java</span>,
        <span class="font-mono text-[13px] text-fg">Python</span> and
        <span class="font-mono text-[13px] text-fg">TypeScript</span>.
      </p>
      <p class="text-fg-subtle">Open to full-stack &amp; AI agent internships.</p>
    </section>

    <section class="space-y-3" data-reveal data-reveal-delay="180">
      <h2 class="font-mono text-[11px] uppercase tracking-[0.12em] text-fg-subtle">Elsewhere</h2>
      <div class="flex flex-wrap items-center gap-2">
        <a
          href="https://github.com/junnhwan"
          target="_blank"
          rel="noopener noreferrer"
          class="h-8 px-3.5 inline-flex items-center gap-1.5 rounded-full pill text-[12px] text-fg-muted"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          GitHub
        </a>
        <a
          href="mailto:3373484735@qq.com"
          class="h-8 px-3.5 inline-flex items-center rounded-full pill font-mono text-[12px] text-fg-muted"
        >
          3373484735@qq.com
        </a>
      </div>
    </section>
    </aside>

    <section class="space-y-3 min-w-0" data-reveal data-reveal-delay="120">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.12em] text-fg-subtle">
          Selected Contributions
        </h2>
        <span class="text-[11px] text-fg-subtle">Open source</span>
      </div>
      <div class="border-t border-line">
        {
          repos.map((repo) => (
            <article class="contribution py-6 border-b border-line">
              <h3 class="text-sm font-semibold text-fg">
                <a
                  href={repo.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link inline-flex max-w-full items-baseline gap-2 font-mono"
                >
                  <span class="min-w-0 break-words">{repo.name}</span>
                  <span aria-hidden="true" class="shrink-0 text-accent">↗</span>
                </a>
              </h3>
              <p class="mt-1.5 text-[13px] leading-relaxed text-fg-muted">{repo.description}</p>
              <p class="mt-4 text-[11px] font-medium text-fg-subtle">Selected merged PRs</p>
              <ul class="mt-1 space-y-0.5">
                {repo.prs.map((pr) => (
                  <li>
                    <a
                      href={`${repo.url}/pull/${pr.number}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="pr-link grid grid-cols-[3.5rem_minmax(0,1fr)] gap-2 rounded-md px-2 py-2 -mx-2 text-[13px] leading-relaxed"
                    >
                      <span class="font-mono text-accent">#{pr.number}</span>
                      <span>{pr.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <a
        href="https://github.com/search?q=is%3Apr+is%3Amerged+author%3Ajunnhwan&type=pullrequests"
        target="_blank"
        rel="noopener noreferrer"
        class="project-link inline-flex items-center gap-1.5 text-[12px] text-accent"
      >
        All merged contributions <span aria-hidden="true">↗</span>
      </a>
    </section>


  </div>
</BaseLayout>

<style>
  .project-link {
    text-underline-offset: 4px;
    transition: color var(--dur-fast) var(--ease);
  }

  .project-link:hover,
  .project-link:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }

  .pr-link {
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .pr-link:hover,
  .pr-link:focus-visible {
    background-color: var(--surface-hover);
    color: var(--fg);
  }
</style>
