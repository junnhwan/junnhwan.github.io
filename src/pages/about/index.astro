---
import BaseLayout from '../../layouts/BaseLayout.astro';

const repos = [
  {
    name: 'k8sgpt-ai / k8sgpt',
    url: 'https://github.com/k8sgpt-ai/k8sgpt',
    description: 'Giving Kubernetes Superpowers to everyone',
  },
  {
    name: 'kubevela / kubevela',
    url: 'https://github.com/kubevela/kubevela',
    description: 'The Modern Application Platform',
  },
  {
    name: 'k0sproject / k0smotron',
    url: 'https://github.com/k0sproject/k0smotron',
    description: 'Kubernetes in Kubernetes',
  },
];
---

<BaseLayout
  title="About · junnhwan"
  description="About junnhwan — CS student at Shenzhen University, full-stack & AI agent developer in the making."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 space-y-12">
    <header class="flex items-center gap-4" data-reveal>
      <img
        src="/avatar.png"
        alt="junnhwan"
        class="w-14 h-14 rounded-full object-cover border border-line"
        loading="eager"
      />
      <div class="min-w-0">
        <div class="flex items-baseline gap-2.5">
          <h1 class="text-xl font-semibold text-fg">hwan</h1>
          <span class="font-mono text-xs text-fg-subtle">@junnhwan</span>
        </div>
        <p class="mt-0.5 text-[13px] text-fg-muted">
          Full-stack &amp; AI Agent developer in the making.
        </p>
      </div>
    </header>

    <section class="space-y-4 text-[14px] leading-[1.9]" data-reveal data-reveal-delay="60">
      <p>
        I'm <span class="text-fg">Junnhwan</span>, majoring in Computer Science at Shenzhen
        University (Class of 2028).
      </p>
      <p>
        Building full-stack apps, and diving into AI agents. Working mostly in
        <span class="font-mono text-[13px] text-fg">Go</span>,
        <span class="font-mono text-[13px] text-fg">Java</span>,
        <span class="font-mono text-[13px] text-fg">Python</span> and
        <span class="font-mono text-[13px] text-fg">TypeScript</span>.
      </p>
      <p class="text-fg-subtle">Open to full-stack &amp; AI agent internships.</p>
    </section>

    <section class="space-y-3" data-reveal data-reveal-delay="120">
      <h2 class="font-mono text-[11px] uppercase tracking-[0.12em] text-fg-subtle">Open Source</h2>
      <div class="border-t border-line">
        {
          repos.map((repo) => (
            <a
              href={repo.url}
              target="_blank"
              rel="noopener noreferrer"
              class="row py-3.5 flex flex-col sm:flex-row sm:items-baseline sm:gap-4"
            >
              <span class="row-title font-mono text-[13px] text-fg-muted">{repo.name}</span>
              <span class="text-[12px] text-fg-subtle">{repo.description}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="space-y-3" data-reveal data-reveal-delay="180">
      <h2 class="font-mono text-[11px] uppercase tracking-[0.12em] text-fg-subtle">Elsewhere</h2>
      <div class="flex flex-wrap items-center gap-2">
        <a
          href="https://github.com/junnhwan"
          target="_blank"
          rel="noopener noreferrer"
          class="h-8 px-3.5 inline-flex items-center gap-1.5 rounded-full pill text-[12px] text-fg-muted"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          GitHub
        </a>
        <a
          href="mailto:3373484735@qq.com"
          class="h-8 px-3.5 inline-flex items-center rounded-full pill font-mono text-[12px] text-fg-muted"
        >
          3373484735@qq.com
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
