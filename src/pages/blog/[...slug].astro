---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { calculateReadingTime, formatDate } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const readingTime = calculateReadingTime(post.body || '');
---

<BaseLayout
  title={`${post.data.title} · junnhwan`}
  description={post.data.description}
  keywords={post.data.tags.join(', ')}
  ogType="article"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <!-- Back to Blog Navigation -->
    <div class="mb-6">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-cyan-400 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2005/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>返回文章列表</span>
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
      <!-- Article Content Main Column (Spans 3 cols) -->
      <article class="lg:col-span-3 min-w-0">
        <!-- Header -->
        <header class="mb-8 pb-6 border-b border-white/10 space-y-3">
          <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-400 font-mono">
            {
              post.data.category && (
                <span class="px-2 py-0.5 rounded bg-white/5 text-cyan-400 border border-white/10">
                  {post.data.category}
                </span>
              )
            }
            <span>{formatDate(post.data.pubDate)}</span>
            <span>·</span>
            <span>{readingTime}</span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight leading-snug">
            {post.data.title}
          </h1>

          {
            post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 pt-1">
                {post.data.tags.map((tag: string) => (
                  <span class="text-xs text-slate-400 font-mono">
                    #{tag}
                  </span>
                ))}
              </div>
            )
          }
        </header>

        <!-- Markdown Rendered Content with Enhanced Prose Typography -->
        <div class="prose max-w-none">
          <Content />
        </div>

        <!-- Post Footer Navigation -->
        <div class="mt-14 pt-6 border-t border-white/10 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            prevPost ? (
              <a
                href={`/blog/${prevPost.slug}`}
                class="p-4 rounded-xl bg-white/[0.02] hover:bg-white/[0.05] border border-white/5 hover:border-white/15 transition-all flex flex-col gap-1"
              >
                <span class="text-[11px] text-slate-500 font-mono">← 上一篇</span>
                <span class="text-xs sm:text-sm font-medium text-slate-200 hover:text-cyan-400 transition-colors line-clamp-1">
                  {prevPost.data.title}
                </span>
              </a>
            ) : (
              <div />
            )
          }

          {
            nextPost ? (
              <a
                href={`/blog/${nextPost.slug}`}
                class="p-4 rounded-xl bg-white/[0.02] hover:bg-white/[0.05] border border-white/5 hover:border-white/15 transition-all flex flex-col gap-1 text-right"
              >
                <span class="text-[11px] text-slate-500 font-mono">下一篇 →</span>
                <span class="text-xs sm:text-sm font-medium text-slate-200 hover:text-cyan-400 transition-colors line-clamp-1">
                  {nextPost.data.title}
                </span>
              </a>
            ) : (
              <div />
            )
          }
        </div>
      </article>

      <!-- TOC Sidebar -->
      <aside class="hidden lg:block lg:col-span-1">
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>
