---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BlogFilter } from '../../components/BlogFilter';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/readingTime';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formattedPosts = sortedPosts.map((p) => ({
  slug: p.slug,
  data: {
    title: p.data.title,
    description: p.data.description,
    pubDate: formatDate(p.data.pubDate),
    tags: p.data.tags,
    category: p.data.category,
    featured: p.data.featured,
  },
}));
---

<BaseLayout
  title="文章 · junnhwan's blog"
  description="junnhwan 的技术文章、学习笔记与面经复盘。"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-10" data-reveal>
      <div class="flex items-baseline justify-between gap-4">
        <div>
          <h1 class="text-xl font-semibold text-fg">文章</h1>
          <p class="mt-1 text-[13px] text-fg-subtle">学习笔记、面经复盘与技术总结</p>
        </div>
        <div class="flex items-center gap-3 font-mono text-[11px] text-fg-subtle">
          <a href="/categories" class="hover:text-accent transition-colors">分类</a>
          <span class="text-line-strong">/</span>
          <a href="/tags" class="hover:text-accent transition-colors">标签</a>
        </div>
      </div>
    </header>

    <div data-reveal data-reveal-delay="60">
      <BlogFilter client:load posts={formattedPosts} />
    </div>
  </div>
</BaseLayout>
