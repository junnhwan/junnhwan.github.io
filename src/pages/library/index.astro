---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { learningDocuments, documentHref } from '../../data/library';

const topics = [...new Set(learningDocuments.map((doc) => doc.topic))].sort((a, b) =>
  a.localeCompare(b, 'zh-CN')
);
const hasDocuments = learningDocuments.length > 0;
---

<BaseLayout
  title="资料库 · junnhwan's blog"
  description="集中收录学习手册、交互笔记与专题资料，让学习记录随时可读。"
>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <div class="page-shell library-shell">
    <header class="library-header" data-reveal>
      <div>
        <p class="library-eyebrow">LEARNING LIBRARY</p>
        <h1>资料库<span aria-hidden="true">.</span></h1>
        <p class="library-intro">把零散的学习资料，放在一个随时能回来的地方。</p>
      </div>
      <div class="library-total" aria-label={`已收录 ${learningDocuments.length} 份资料`}>
        <span>{String(learningDocuments.length).padStart(2, '0')}</span>
        <span>份学习资料</span>
      </div>
    </header>

    {hasDocuments ? (
      <section class="library-collection" data-library data-reveal data-reveal-delay="60" aria-label="学习资料">
        <aside class="library-sidebar" aria-label="资料筛选">
          <label class="library-search">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" />
            </svg>
            <input type="search" placeholder="查找学习资料" aria-label="按标题、主题或标签查找资料" data-library-search />
          </label>
          <div class="library-topics">
            <p class="library-caption">按主题浏览</p>
            <button type="button" data-library-topic="" aria-pressed="true">
              <span>全部资料</span><span>{learningDocuments.length}</span>
            </button>
            {topics.map((topic) => (
              <button type="button" data-library-topic={topic} aria-pressed="false">
                <span>{topic}</span><span>{learningDocuments.filter((doc) => doc.topic === topic).length}</span>
              </button>
            ))}
          </div>
          <p class="library-sidebar-note">每份资料保留自己的排版与交互，打开后即可继续阅读。</p>
        </aside>
        <div class="library-results">
          <div class="library-result-bar">
            <p data-library-count aria-live="polite">{learningDocuments.length} 份资料</p>
            <span>最近更新</span>
          </div>
          <div class="library-list">
            {learningDocuments.map((doc, index) => (
              <a
                class="library-document"
                href={documentHref(doc)}
                data-astro-reload
                data-library-card
                data-topic={doc.topic}
                data-search={[doc.title, doc.description, doc.topic, ...doc.tags].join(' ').toLocaleLowerCase()}
              >
                <span class="library-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div class="library-document-copy">
                  <p class="library-document-meta"><span>{doc.topic}</span><span>HTML</span></p>
                  <h2>{doc.title}</h2>
                  <p class="library-description">{doc.description}</p>
                  <div class="library-tags">{doc.tags.map((tag) => <span>{tag}</span>)}</div>
                </div>
                <div class="library-document-end">
                  <time datetime={doc.updatedAt}>{doc.updatedAt.replaceAll('-', '.')}</time>
                  <span class="library-open">阅读资料 <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            ))}
          </div>
          <div class="library-no-results" data-library-empty hidden>
            <p>暂时没有找到对应资料</p>
            <span>试试更短的关键词，或浏览全部主题。</span>
            <button type="button" data-library-reset>清除筛选 <span aria-hidden="true">↗</span></button>
          </div>
        </div>
      </section>
    ) : (
      <section class="library-empty" data-reveal data-reveal-delay="60" aria-labelledby="library-empty-title">
        <div class="library-illustration" aria-hidden="true">
          <svg viewBox="0 0 240 240" fill="none">
            <rect class="library-sheet-back" x="47" y="37" width="136" height="166" rx="5" />
            <rect class="library-sheet-front" x="60" y="48" width="136" height="166" rx="5" />
            <path class="library-sheet-fold" d="M159 48v34h37" />
            <path class="library-sheet-lines" d="M84 111h88M84 129h88M84 147h63M84 178h33" />
            <path class="library-sheet-mark" d="M84 74h20m-10-10v20" />
            <path class="library-orbit" d="M28 208h32M207 32v24M218 44h-24" />
          </svg>
        </div>
        <div class="library-empty-copy">
          <p class="library-eyebrow">A PLACE TO RETURN TO</p>
          <h2 id="library-empty-title">等待第一份<br />学习资料<span aria-hidden="true">.</span></h2>
          <p>学习手册、交互笔记、专题文档。<br class="library-desktop-break" />整理后的资料会陆续收录在这里，方便在不同设备上继续阅读。</p>
          <a href="/blog/" class="library-empty-link">先读一篇文章 <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    )}

    <footer class="library-footnote">
      <span>笔记留在这里，学习持续发生。</span>
      <a href="/blog/">文章 <span aria-hidden="true">↗</span></a>
    </footer>
  </div>
</BaseLayout>

<script>
  function setupLibrary() {
    const library = document.querySelector<HTMLElement>('[data-library]');
    if (!library) return;
    const input = library.querySelector<HTMLInputElement>('[data-library-search]');
    const buttons = [...library.querySelectorAll<HTMLButtonElement>('[data-library-topic]')];
    const cards = [...library.querySelectorAll<HTMLAnchorElement>('[data-library-card]')];
    const count = library.querySelector<HTMLElement>('[data-library-count]');
    const empty = library.querySelector<HTMLElement>('[data-library-empty]');
    if (!input || !count || !empty) return;

    const controller = new AbortController();
    const params = new URLSearchParams(window.location.search);
    let topic = buttons.some((button) => button.dataset.libraryTopic === params.get('topic'))
      ? params.get('topic') || '' : '';
    input.value = params.get('q') || '';

    const filter = (updateUrl = true) => {
      const query = input.value.trim().toLocaleLowerCase();
      let visible = 0;
      for (const card of cards) {
        card.hidden = Boolean((topic && card.dataset.topic !== topic) || !card.dataset.search?.includes(query));
        if (!card.hidden) visible += 1;
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.libraryTopic === topic));
      }
      count.textContent = `${visible} 份资料`;
      empty.hidden = visible > 0;
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (topic) url.searchParams.set('topic', topic); else url.searchParams.delete('topic');
        if (query) url.searchParams.set('q', input.value.trim()); else url.searchParams.delete('q');
        window.history.replaceState(window.history.state, '', url);
      }
    };

    input.addEventListener('input', () => filter(), { signal: controller.signal });
    buttons.forEach((button) => button.addEventListener('click', () => {
      topic = button.dataset.libraryTopic || '';
      filter();
    }, { signal: controller.signal }));
    library.querySelector('[data-library-reset]')?.addEventListener('click', () => {
      topic = '';
      input.value = '';
      filter();
      input.focus();
    }, { signal: controller.signal });
    window.addEventListener('popstate', () => {
      const next = new URLSearchParams(window.location.search);
      topic = buttons.some((button) => button.dataset.libraryTopic === next.get('topic'))
        ? next.get('topic') || '' : '';
      input.value = next.get('q') || '';
      filter(false);
    }, { signal: controller.signal });
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    filter(false);
  }
  document.addEventListener('astro:page-load', setupLibrary);
</script>

<style>
  .library-shell { padding-top: 3.6rem; padding-bottom: 3rem; }
  .library-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; padding-bottom: 2.6rem; border-bottom: 1px solid var(--line-strong); }
  .library-eyebrow { color: var(--fg-subtle); font: 10px/1.5 'JetBrains Mono Variable', monospace; letter-spacing: .16em; }
  .library-header h1 { margin: .7rem 0 1rem; color: var(--fg); font: 500 clamp(2.5rem, 5vw, 3.75rem)/1.2 var(--font-reading); }
  .library-header h1 > span, .library-empty-copy h2 > span { color: var(--accent); }
  .library-intro { font-size: .95rem; color: var(--fg-muted); line-height: 1.8; }
  .library-total { display: flex; flex-direction: column; gap: .4rem; text-align: right; flex-shrink: 0; }
  .library-total > span:first-child { color: var(--fg); font: 300 3rem/1 'JetBrains Mono Variable', monospace; letter-spacing: -.07em; }
  .library-total > span:last-child { color: var(--fg-subtle); font-size: .72rem; }
  .library-empty { display: grid; grid-template-columns: .9fr 1.1fr; align-items: center; gap: 3rem; min-height: 440px; padding: 4rem 3rem; background: linear-gradient(125deg, var(--accent-soft), transparent 62%); border-bottom: 1px solid var(--line); }
  .library-illustration { display: flex; justify-content: center; }
  .library-illustration svg { width: min(100%, 240px); overflow: visible; }
  .library-sheet-back { fill: var(--bg-soft); stroke: var(--line-strong); transform: rotate(-7deg); transform-origin: 50% 50%; }
  .library-sheet-front { fill: var(--bg); stroke: var(--accent-line); }
  .library-sheet-fold { stroke: var(--accent-line); }
  .library-sheet-lines { stroke: var(--line-strong); }
  .library-sheet-mark { stroke: var(--accent); stroke-width: 1.5; }
  .library-orbit { stroke: var(--accent-line); }
  .library-empty-copy h2 { margin: 1rem 0 1.4rem; color: var(--fg); font: 500 clamp(1.9rem, 3vw, 2.8rem)/1.5 var(--font-reading); }
  .library-empty-copy > p:not(.library-eyebrow) { max-width: 420px; font-size: .9rem; line-height: 2; color: var(--fg-subtle); }
  .library-empty-link { margin-top: 2rem; display: inline-flex; align-items: center; gap: 1rem; color: var(--accent); font-size: .875rem; }
  .library-empty-link > span { transition: transform var(--dur) var(--ease); }
  .library-empty-link:hover > span { transform: translate(3px, -3px); }
  .library-collection { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 3.8rem; padding-top: 2.5rem; }
  .library-sidebar { position: sticky; top: 7.5rem; align-self: start; }
  .library-search { display: flex; gap: .65rem; align-items: center; border-bottom: 1px solid var(--line-strong); padding: .5rem 0 .8rem; color: var(--fg-subtle); }
  .library-search:focus-within { color: var(--accent); border-color: var(--accent); }
  .library-search input { min-width: 0; width: 100%; background: transparent; font-size: .85rem; color: var(--fg); border: 0; outline: none; }
  .library-search input::placeholder { color: var(--fg-subtle); }
  .library-topics { margin-top: 2rem; }
  .library-caption { font-size: .7rem; color: var(--fg-subtle); margin-bottom: .9rem; }
  .library-topics button { display: flex; align-items: center; justify-content: space-between; gap: 1rem; width: 100%; min-height: 44px; padding: .6rem .8rem; margin: .2rem 0; border-radius: 6px; text-align: left; color: var(--fg-muted); font-size: .825rem; transition: color var(--dur-fast), background var(--dur-fast); }
  .library-topics button > span:last-child { font: 10px 'JetBrains Mono Variable', monospace; color: var(--fg-subtle); }
  .library-topics button:hover { background: var(--surface-hover); color: var(--fg); }
  .library-topics button[aria-pressed='true'] { color: var(--accent); background: var(--accent-soft); }
  .library-sidebar-note { margin-top: 2rem; padding-top: 1.1rem; border-top: 1px solid var(--line); color: var(--fg-subtle); font-size: .75rem; line-height: 1.9; }
  .library-result-bar { display: flex; justify-content: space-between; color: var(--fg-subtle); font-size: .7rem; padding: .6rem 0 1rem; border-bottom: 1px solid var(--line); }
  .library-document { display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto; align-items: start; gap: 1rem; padding: 1.8rem .2rem; border-bottom: 1px solid var(--line); transition: background var(--dur), border-color var(--dur); }
  .library-document[hidden] { display: none; }
  .library-document:hover { background: var(--surface-hover); border-bottom-color: var(--accent-line); }
  .library-index { color: var(--fg-subtle); font: 10px/1.8 'JetBrains Mono Variable', monospace; padding-top: 2px; }
  .library-document-meta { display: flex; align-items: center; gap: .7rem; color: var(--accent); font-size: .65rem; }
  .library-document-meta > span:last-child { color: var(--fg-subtle); font: 9px/1.5 'JetBrains Mono Variable', monospace; border: 1px solid var(--line-strong); border-radius: 3px; padding: 0 .3rem; }
  .library-document h2 { color: var(--fg); font-size: 1.15rem; font-weight: 500; line-height: 1.6; margin: .6rem 0; transition: color var(--dur-fast); }
  .library-document:hover h2 { color: var(--accent); }
  .library-description { color: var(--fg-subtle); line-height: 1.8; font-size: .825rem; }
  .library-tags { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: .9rem; font-size: .65rem; color: var(--fg-subtle); }
  .library-tags > span { padding: .1rem .45rem; border-radius: 3px; background: var(--surface-hover); }
  .library-document-end { display: flex; flex-direction: column; gap: 2rem; align-items: flex-end; }
  .library-document-end time { white-space: nowrap; color: var(--fg-subtle); font: 10px/1.8 'JetBrains Mono Variable', monospace; }
  .library-open { color: var(--fg-subtle); font-size: .7rem; display: flex; align-items: center; gap: .5rem; transition: color var(--dur); }
  .library-open > span { display: inline-block; transition: transform var(--dur) var(--ease); }
  .library-document:hover .library-open { color: var(--accent); }
  .library-document:hover .library-open > span { transform: translate(3px, -3px); }
  .library-no-results { padding: 4rem 1rem; text-align: center; }
  .library-no-results > p { color: var(--fg); margin-bottom: .6rem; font-size: 1rem; }
  .library-no-results > span { color: var(--fg-subtle); font-size: .825rem; }
  .library-no-results button { display: block; margin: 1.5rem auto 0; color: var(--accent); font-size: .825rem; min-height: 44px; }
  .library-footnote { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.5rem; font-size: .72rem; color: var(--fg-subtle); }
  .library-footnote a { min-height: 36px; display: flex; gap: .6rem; align-items: center; transition: color var(--dur-fast); }
  .library-footnote a:hover { color: var(--accent); }
  @media (prefers-reduced-motion: reduce) {
    .library-empty-link > span, .library-open > span, .library-document { transition: none; }
  }
  @media (max-width: 767px) {
    .library-shell { padding-top: 2.5rem; }
    .library-header { padding-bottom: 2rem; }
    .library-total > span:first-child { font-size: 2.4rem; }
    .library-intro { max-width: 260px; font-size: .85rem; }
    .library-empty { gap: 1.6rem; grid-template-columns: 1fr; padding: 2.5rem 1.5rem 3rem; text-align: center; }
    .library-illustration svg { width: 170px; }
    .library-empty-copy > p:not(.library-eyebrow) { margin-inline: auto; }
    .library-desktop-break { display: none; }
    .library-collection { grid-template-columns: 1fr; gap: 1.6rem; padding-top: 1.5rem; }
    .library-sidebar { position: static; }
    .library-topics { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: .3rem; }
    .library-caption { width: 100%; margin-bottom: .3rem; }
    .library-topics button { width: auto; }
    .library-sidebar-note { display: none; }
    .library-document { grid-template-columns: 1.6rem minmax(0, 1fr); gap: .6rem; padding: 1.4rem 0; }
    .library-document-end { grid-column: 2; flex-direction: row; justify-content: space-between; gap: 1rem; margin-top: .3rem; }
    .library-document h2 { font-size: 1.05rem; }
    .library-footnote { align-items: flex-start; font-size: .65rem; }
  }
</style>
