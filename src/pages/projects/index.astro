---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'learn-claude-code 源码剖析',
    category: 'AI & Agents',
    desc: '系统性拆解 Coding Agent 的实现机制：从 Agent Loop 循环、工具调用（Function Calling）、上下文分级管理到工程化落地安全机制。',
    tech: ['Agent Loop', 'Claude Code', 'Tool Calling', 'TypeScript'],
    links: [
      { label: '阅读文章', href: '/blog/learn-claude-code-notes' },
      { label: 'GitHub', href: 'https://github.com/junnhwan' },
    ],
    highlight: true,
  },
  {
    title: 'Sky Takeout 苍穹外卖系统',
    category: 'Backend & Cloud',
    desc: '基于 Spring Boot + Redis + MySQL 的全功能在线外卖订餐与商家管理系统。覆盖分布式缓存、微信小程序端对接、高并发点单与公共字段自动填充等企业级实战。',
    tech: ['Java', 'Spring Boot', 'Redis', 'MySQL', 'WeChat API'],
    links: [
      { label: '项目笔记系列', href: '/blog/sky-takeout-day01' },
      { label: 'GitHub', href: 'https://github.com/junnhwan' },
    ],
    highlight: true,
  },
  {
    title: 'Modern Geek Blog UI',
    category: 'Frontend & Architecture',
    desc: '基于 Astro 5 + Tailwind CSS + React 打造的次世代开发者博客。具备 Bento 便当盒网格、可交互 Web 终端 CLI、全局 ⌘K 命令搜索面板与流光微交互。',
    tech: ['Astro 5', 'Tailwind CSS', 'React 19', 'TypeScript'],
    links: [
      { label: '在线体验', href: '/' },
      { label: '源码仓库', href: 'https://github.com/junnhwan/junnhwan.github.io' },
    ],
    highlight: true,
  },
  {
    title: 'Kubernetes & AI 诊断实践',
    category: 'Cloud Native',
    desc: '参与开源 K8s 诊断工具生态建设与分析器机制实践，探索利用大语言模型自动化诊断集群故障。',
    tech: ['Go', 'Kubernetes', 'LLM Diagnostic', 'DevOps'],
    links: [
      { label: 'GitHub', href: 'https://github.com/junnhwan' },
    ],
    highlight: false,
  },
];
---

<BaseLayout
  title="项目与实践 · junnhwan's blog"
  description="junnhwan 的精选项目与开源实践：AI Agent、后端高并发与现代前端架构。"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header banner -->
    <div class="mb-10 space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">
        <span>Showcase & Open Source</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        精选项目与开源
      </h1>
      <p class="text-sm text-slate-400">
        坚信 "Learn by Building"，以下是沉淀的技术项目与工程化实践。
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        projects.map((proj) => (
          <div
            class={`rounded-3xl glass-card p-6 bg-slate-950/70 border transition-all flex flex-col justify-between group ${
              proj.highlight
                ? 'border-cyan-500/30 hover:border-cyan-400 shadow-[0_0_20px_rgba(0,242,254,0.08)]'
                : 'border-white/5 hover:border-white/20'
            }`}
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="px-2.5 py-1 rounded-md text-[10px] font-mono font-semibold bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">
                  {proj.category}
                </span>
              </div>

              <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition-colors leading-snug">
                {proj.title}
              </h3>

              <p class="text-xs sm:text-sm text-slate-400 mt-2.5 leading-relaxed">
                {proj.desc}
              </p>

              <!-- Tech Pills -->
              <div class="flex flex-wrap gap-1.5 mt-4">
                {proj.tech.map((t) => (
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono text-slate-300 bg-white/5 border border-white/5">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-5 mt-5 border-t border-white/5 flex items-center justify-between text-xs">
              <div class="flex items-center gap-3">
                {proj.links.map((link) => (
                  <a
                    href={link.href}
                    target={link.href.startsWith('http') ? '_blank' : '_self'}
                    rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="font-semibold text-cyan-400 hover:text-cyan-300 inline-flex items-center gap-1"
                  >
                    <span>{link.label}</span>
                    <svg xmlns="http://www.w3.org/2005/svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
