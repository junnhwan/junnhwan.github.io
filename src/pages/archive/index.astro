---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/readingTime';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsByYear = sortedPosts.reduce(
  (acc, post) => {
    const year = post.data.pubDate.getFullYear().toString();
    (acc[year] ||= []).push(post);
    return acc;
  },
  {} as Record<string, typeof sortedPosts>
);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="归档 · junnhwan's blog" description="junnhwan 博客的全部文章时间线。">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-10" data-reveal>
      <h1 class="text-xl font-semibold text-fg">归档</h1>
      <p class="mt-1 text-[13px] text-fg-subtle">
        共 <span class="font-mono tabular-nums">{sortedPosts.length}</span> 篇
      </p>
    </header>

    <div class="space-y-10">
      {
        years.map((year, index) => (
          <section data-reveal data-reveal-delay={index * 60}>
            <div class="flex items-baseline gap-3 mb-1">
              <h2 class="font-mono text-sm text-fg">{year}</h2>
              <span class="font-mono text-[11px] text-fg-subtle">
                {postsByYear[year].length}
              </span>
            </div>

            <div class="border-t border-line">
              {postsByYear[year].map((post) => (
                <a href={`/blog/${post.slug}`} class="row py-3 flex items-baseline gap-4">
                  <time class="w-12 shrink-0 font-mono text-xs text-fg-subtle tabular-nums">
                    {formatDate(post.data.pubDate).slice(5)}
                  </time>
                  <span class="row-title min-w-0 flex-1 text-[14px] text-fg-muted truncate">
                    {post.data.title}
                  </span>
                  {post.data.category && (
                    <span class="shrink-0 font-mono text-[11px] text-fg-subtle hidden sm:inline">
                      {post.data.category}
                    </span>
                  )}
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
