---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/readingTime';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const tagGroups = Array.from(
  posts.reduce((groups, post) => {
    for (const tag of post.data.tags) {
      const group = groups.get(tag) || [];
      group.push(post);
      groups.set(tag, group);
    }
    return groups;
  }, new Map<string, typeof posts>())
).sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout title="标签 · junnhwan's blog" description="按标签浏览 junnhwan 的文章。">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-10" data-reveal>
      <h1 class="text-xl font-semibold text-fg">标签</h1>
      <p class="mt-1 text-[13px] text-fg-subtle">
        {tagGroups.length} 个标签 · {posts.length} 篇文章
      </p>
    </header>

    <div class="space-y-10">
      {
        tagGroups.map(([tag, tagPosts], index) => (
          <section data-reveal data-reveal-delay={index * 40}>
            <div class="flex items-baseline gap-3 mb-1">
              <h2 class="font-mono text-sm text-accent">#{tag}</h2>
              <span class="font-mono text-[11px] text-fg-subtle">{tagPosts.length}</span>
            </div>
            <div class="border-t border-line">
              {tagPosts
                .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
                .map((post) => (
                  <a href={`/blog/${post.slug}`} class="row py-3 flex items-baseline gap-4">
                    <time class="w-20 shrink-0 font-mono text-xs text-fg-subtle tabular-nums">
                      {formatDate(post.data.pubDate)}
                    </time>
                    <span class="row-title min-w-0 flex-1 text-[14px] text-fg-muted truncate">
                      {post.data.title}
                    </span>
                  </a>
                ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
