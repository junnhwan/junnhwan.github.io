---
// Original pen paths, kept as vectors so the signature stays sharp at any size.
const strokes = [
  'M32 98 C8 72 66 8 86 30 C100 47 59 123 39 151 M54 109 C86 79 126 76 145 77 M166 29 C148 60 126 115 124 140 C123 161 149 133 164 118',
  'M173 74 C186 36 203 36 200 60 L175 135 C167 164 202 126 241 72 C218 131 219 153 234 143 C261 121 279 81 292 59 C306 33 318 42 308 65 C299 88 279 112 263 119',
  'M286 144 C321 116 349 68 378 39 C389 28 395 29 390 43 C379 78 360 119 366 137 C371 152 390 137 403 124 M316 115 C342 95 374 91 397 94',
  'M399 139 C414 106 427 76 442 56 C450 43 455 43 454 56 L442 119 C440 143 448 145 460 128 C486 96 503 64 527 38 C546 17 558 29 545 51 C530 77 493 129 486 151 C482 166 501 160 517 147',
  'M517 147 C562 111 605 100 617 115 C636 140 495 169 371 175 C278 180 215 180 178 174 C158 170 164 166 180 164',
];
---

<div class="signature-block" data-signature>
  <h1 aria-label="HWAN" class="signature-heading">
    <span class="signature-ink">
      <svg viewBox="0 0 650 205" aria-hidden="true" focusable="false">
        {strokes.map((d, index) => (
          <path d={d} pathLength={1} class="signature-stroke"
            style={`animation-delay: ${index * 420}ms; stroke-width: ${index === 4 ? 1.8 : 3.2};`} />
        ))}
      </svg>
    </span>
  </h1>
  <p class="signature-motto" aria-label="Be Here Now">
    <span aria-hidden="true"><i>Be</i> <i>Here</i> <i>Now</i></span>
    <svg viewBox="0 0 240 22" aria-hidden="true" focusable="false">
      <path d="M8 15 Q100 0 227 10 M205 8 Q227 10 233 6" pathLength={1} />
    </svg>
  </p>
</div>

<script>
  // The ink leans toward the pointer on the same spring the old React island
  // used (stiffness 140, damping 22), without shipping a framework for one h1.
  function spring(stiffness: number, damping: number) {
    let value = 0;
    let velocity = 0;
    let target = 0;
    return {
      set(next: number) { target = next; },
      release() { target = 0; },
      step(dt: number) {
        velocity += (stiffness * (target - value) - damping * velocity) * dt;
        value += velocity * dt;
        return value;
      },
      settled() { return Math.abs(target - value) < .01 && Math.abs(velocity) < .01; },
    };
  }

  function mountSignature(root: HTMLElement) {
    if (root.dataset.signatureMounted === 'true') return;
    const ink = root.querySelector<HTMLElement>('.signature-ink');
    const heading = root.querySelector<HTMLElement>('.signature-heading');
    if (!ink || !heading) return;
    root.dataset.signatureMounted = 'true';

    const ready = window.setTimeout(() => { root.dataset.ready = 'true'; }, 80);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    const x = spring(140, 22);
    const y = spring(140, 22);
    const rotate = spring(140, 22);
    let frame = 0;
    let last = 0;

    const tick = (now: number) => {
      frame = 0;
      const dt = Math.min((now - (last || now - 16)) / 1000, .05);
      last = now;
      const px = x.step(dt);
      const py = y.step(dt);
      const angle = rotate.step(dt);
      ink.style.transform = `translate3d(${px}px, ${py}px, 0) rotate(${angle}deg)`;
      if (!x.settled() || !y.settled() || !rotate.settled()) frame = requestAnimationFrame(tick);
      else ink.style.transform = '';
    };
    const wake = () => {
      last = 0;
      if (!frame) frame = requestAnimationFrame(tick);
    };
    const settle = () => {
      x.release();
      y.release();
      rotate.release();
      wake();
    };
    const onMove = (event: PointerEvent) => {
      if (reduced.matches || !fine.matches || event.pointerType === 'touch') return;
      const box = heading.getBoundingClientRect();
      const dx = (event.clientX - box.left) / box.width - .5;
      const dy = (event.clientY - box.top) / box.height - .5;
      x.set(dx * 10);
      y.set(dy * 8);
      rotate.set(dx * 2.5);
      wake();
    };
    const onCapabilities = () => {
      if (reduced.matches || !fine.matches) settle();
    };

    heading.addEventListener('pointermove', onMove, { passive: true });
    heading.addEventListener('pointerleave', settle, { passive: true });
    reduced.addEventListener('change', onCapabilities);
    fine.addEventListener('change', onCapabilities);
    onCapabilities();

    return () => {
      window.clearTimeout(ready);
      cancelAnimationFrame(frame);
      heading.removeEventListener('pointermove', onMove);
      heading.removeEventListener('pointerleave', settle);
      reduced.removeEventListener('change', onCapabilities);
      fine.removeEventListener('change', onCapabilities);
      delete root.dataset.signatureMounted;
    };
  }

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-signature]');
    if (!root) return;
    const dispose = mountSignature(root);
    if (dispose) document.addEventListener('astro:before-swap', dispose, { once: true });
  });
</script>
