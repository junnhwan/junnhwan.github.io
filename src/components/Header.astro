---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { name: '首页', href: '/' },
  { name: '文章', href: '/blog' },
  { name: '归档', href: '/archive' },
  { name: '关于', href: '/about' },
];
---

<header class="masthead fixed top-0 inset-x-0 z-40 flex justify-center px-4 pointer-events-none">
  <div
    class="masthead-inner pointer-events-auto flex items-center justify-between gap-4 max-w-[1120px] w-full"
  >
    <!-- Monogram: an H whose posts frame a W -->
    <a href="/" class="masthead-brand group flex items-center gap-2.5" aria-label="junnhwan · 首页">
      <svg
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-fg group-hover:text-accent transition-colors"
        aria-hidden="true"
      >
        <path d="M5 4.5v15" />
        <path d="M19 4.5v15" />
        <path d="M5 7.5 9.5 17 12 10.5 14.5 17 19 7.5" />
      </svg>
      <span class="brand-name text-fg group-hover:text-accent transition-colors">
        junnhwan
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-7">
      {
        navItems.map((item) => {
          const isActive =
            item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class={`masthead-nav transition-colors ${
                isActive
                  ? 'text-accent'
                  : 'text-fg-muted hover:text-fg'
              }`}
            >
              {item.name}
            </a>
          );
        })
      }
    </nav>

    <div class="masthead-tools flex items-center gap-1">
      <button
        id="cmd-palette-trigger"
        type="button"
        class="flex items-center gap-1.5 px-2.5 h-8 rounded-full text-fg-muted hover:text-fg hover:bg-surface-hover transition-colors"
        title="搜索 (⌘K)"
        aria-label="搜索"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.6-3.6"></path>
        </svg>
        <span class="hidden sm:inline text-[11px] font-mono text-fg-subtle">⌘K</span>
      </button>

      <ThemeToggle />

      <a
        href="https://github.com/junnhwan"
        target="_blank"
        rel="noopener noreferrer"
        class="grid place-items-center w-8 h-8 rounded-full text-fg-muted hover:text-fg hover:bg-surface-hover transition-colors"
        title="GitHub @junnhwan"
        aria-label="GitHub"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden grid place-items-center w-8 h-8 rounded-full text-fg-muted hover:text-fg hover:bg-surface-hover transition-colors"
        aria-label="打开导航菜单"
        aria-expanded="false"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        >
          <line x1="4" x2="20" y1="8" y2="8"></line>
          <line x1="4" x2="20" y1="16" y2="16"></line>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden pointer-events-auto absolute top-[76px] inset-x-4 max-w-sm mx-auto surface rounded-2xl p-2 flex-col gap-0.5"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="px-4 py-2.5 rounded-xl text-sm text-fg-muted hover:text-accent hover:bg-surface-hover transition-colors"
        >
          {item.name}
        </a>
      ))
    }
  </div>
</header>

<script>
  function setupMobileMenu() {
    const button = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!button || !menu) return;

    button.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      menu.classList.toggle('flex', !isHidden);
      button.setAttribute('aria-expanded', String(!isHidden));
    });
  }

  document.addEventListener('astro:page-load', setupMobileMenu);
</script>

<style>
  .masthead { background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(16px); }
  .masthead-inner { min-height: 80px; border-bottom: 1px solid var(--line-strong); }
  .brand-name { font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-size: 27px; letter-spacing: -.055em; }
  .masthead-nav { position: relative; display: flex; align-items: center; min-height: 80px; padding: 0 .25rem; font-size: 16px; font-weight: 500; }
  .masthead-nav::after { content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: center; transition: transform var(--dur-fast) var(--ease); }
  .masthead-nav[aria-current="page"]::after, .masthead-nav:focus-visible::after { transform: scaleX(1); }
  .masthead-tools :global(button), .masthead-tools > a { min-width: 40px; min-height: 40px; border-radius: 8px; }
  .masthead-tools :global(svg) { width: 18px; height: 18px; }
  @media (hover: hover) and (pointer: fine) { .masthead-nav:hover::after { transform: scaleX(.55); } .masthead-nav[aria-current="page"]:hover::after { transform: scaleX(1); } }
  @media (max-width: 767px) { .masthead-inner { min-height: 70px; gap: .5rem; } .brand-name { font-size: 23px; } .masthead-brand { gap: .4rem; } .masthead-brand svg { width: 24px; } }
</style>
