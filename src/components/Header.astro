---
const currentPath = Astro.url.pathname;

const navItems = [
  { name: '首页', href: '/' },
  { name: '文章', href: '/blog' },
  { name: '归档', href: '/archive' },
  { name: '关于', href: '/about' },
];
---

<header class="fixed top-4 inset-x-0 z-50 flex justify-center px-4 pointer-events-none">
  <div class="pointer-events-auto flex items-center justify-between gap-4 px-4 py-2 rounded-full glass-card border border-white/10 shadow-2xl backdrop-blur-xl bg-slate-950/70 max-w-4xl w-full">
    <!-- Brand / Logo with Avatar -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="relative w-8 h-8 rounded-full overflow-hidden border border-white/15 group-hover:border-cyan-400 transition-colors flex-shrink-0">
        <img
          src="/avatar.png"
          alt="junnhwan avatar"
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-cyan-400/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
      </div>
      <span class="font-bold text-sm tracking-wide text-white group-hover:text-cyan-400 transition-colors">
        junnhwan
      </span>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-1">
      {
        navItems.map((item) => {
          const isActive =
            item.href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`px-3.5 py-1.5 rounded-full text-xs font-medium transition-all ${
                isActive
                  ? 'bg-cyan-500/15 text-cyan-400 border border-cyan-500/30 shadow-[0_0_12px_rgba(0,242,254,0.15)]'
                  : 'text-slate-300 hover:text-white hover:bg-white/5'
              }`}
            >
              {item.name}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Controls: Command Search & GitHub -->
    <div class="flex items-center gap-2">
      <!-- Search Trigger (⌘K) -->
      <button
        id="cmd-palette-trigger"
        type="button"
        class="flex items-center gap-2 px-2.5 py-1.5 rounded-full bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white text-xs border border-white/10 transition-colors"
        title="搜索文章与页面 (⌘K)"
      >
        <svg xmlns="http://www.w3.org/2005/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-400">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="hidden sm:inline text-[11px] font-mono text-slate-400">⌘K</span>
      </button>

      <!-- GitHub Link -->
      <a
        href="https://github.com/junnhwan"
        target="_blank"
        rel="noopener noreferrer"
        class="p-1.5 rounded-full bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition-colors"
        title="GitHub @junnhwan"
      >
        <svg xmlns="http://www.w3.org/2005/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-1.5 rounded-full bg-white/5 text-slate-300 hover:text-white border border-white/10"
        aria-label="打开导航菜单"
      >
        <svg xmlns="http://www.w3.org/2005/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden pointer-events-auto absolute top-16 inset-x-4 max-w-sm mx-auto glass-card rounded-2xl p-3 border border-white/10 shadow-2xl bg-slate-950/90 flex flex-col gap-1">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="px-4 py-2.5 rounded-xl text-sm font-medium text-slate-200 hover:text-cyan-400 hover:bg-white/5 transition-colors"
        >
          {item.name}
        </a>
      ))
    }
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
