---
import { getCollection } from 'astro:content';
import { TerminalCli } from './TerminalCli';
import { SkillMatrix } from './SkillMatrix';
import { calculateReadingTime, formatDate } from '../utils/readingTime';

const allPosts = await getCollection('blog');
const featuredPost = allPosts.find((p) => p.data.featured) || allPosts[0];
const readingTime = calculateReadingTime(featuredPost.body || '');
---

<section class="max-w-4xl mx-auto px-4 sm:px-6 py-6">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <!-- Card 1: Featured Spotlight Post (Spans 2 columns on desktop) -->
    <div class="md:col-span-2 relative group rounded-3xl p-[1px] bg-gradient-to-b from-cyan-500/40 via-blue-500/20 to-transparent shadow-xl">
      <div class="relative h-full w-full rounded-3xl glass-card p-6 flex flex-col justify-between overflow-hidden bg-slate-950/80">
        <!-- Background subtle glow -->
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                ⭐ 精选置顶 / Featured
              </span>
              <span class="text-xs text-slate-400 font-mono">
                {formatDate(featuredPost.data.pubDate)}
              </span>
            </div>
            <span class="text-[11px] font-mono text-slate-500">{readingTime}</span>
          </div>

          <a href={`/blog/${featuredPost.slug}`} class="block group/link">
            <h3 class="text-xl sm:text-2xl font-bold text-white group-hover/link:text-cyan-400 transition-colors leading-snug">
              {featuredPost.data.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-400 mt-2.5 leading-relaxed line-clamp-3">
              {featuredPost.data.description}
            </p>
          </a>
        </div>

        <div class="pt-5 mt-4 border-t border-white/5 flex items-center justify-between">
          <div class="flex flex-wrap gap-1.5">
            {featuredPost.data.tags.slice(0, 3).map((tag: string) => (
              <span class="px-2 py-0.5 rounded-md text-[11px] font-mono text-slate-300 bg-white/5 border border-white/5">
                #{tag}
              </span>
            ))}
          </div>

          <a
            href={`/blog/${featuredPost.slug}`}
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-cyan-400 hover:text-cyan-300 group-hover:translate-x-1 transition-all"
          >
            <span>立即阅读</span>
            <svg xmlns="http://www.w3.org/2005/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Card 2: Quick Metrics & Status -->
    <div class="rounded-3xl glass-card p-6 flex flex-col justify-between bg-slate-950/80">
      <div>
        <div class="flex items-center justify-between mb-4">
          <h4 class="font-bold text-sm text-white">站点遥测 & 状态</h4>
          <span class="text-[10px] font-mono text-emerald-400 px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20">
            ONLINE
          </span>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="p-3 rounded-2xl bg-white/[0.03] border border-white/5">
            <span class="text-[11px] text-slate-400">文章总数</span>
            <div class="text-xl font-bold font-mono text-white mt-1">9</div>
          </div>
          <div class="p-3 rounded-2xl bg-white/[0.03] border border-white/5">
            <span class="text-[11px] text-slate-400">技术标签</span>
            <div class="text-xl font-bold font-mono text-cyan-400 mt-1">12+</div>
          </div>
          <div class="p-3 rounded-2xl bg-white/[0.03] border border-white/5">
            <span class="text-[11px] text-slate-400">累计字数</span>
            <div class="text-xl font-bold font-mono text-emerald-400 mt-1">50k+</div>
          </div>
          <div class="p-3 rounded-2xl bg-white/[0.03] border border-white/5">
            <span class="text-[11px] text-slate-400">运行环境</span>
            <div class="text-xs font-bold font-mono text-slate-200 mt-1.5">Astro 5.x</div>
          </div>
        </div>
      </div>

      <div class="pt-4 mt-4 border-t border-white/5 text-[11px] text-slate-400 flex items-center justify-between">
        <span>快捷搜索</span>
        <kbd class="px-2 py-0.5 rounded bg-white/10 text-slate-300 font-mono text-[10px] border border-white/10">⌘K</kbd>
      </div>
    </div>

    <!-- Card 3: Interactive CLI Terminal (Spans 2 columns on desktop) -->
    <div id="terminal-section" class="md:col-span-2">
      <TerminalCli client:visible />
    </div>

    <!-- Card 4: Skill Matrix -->
    <div class="rounded-3xl glass-card p-6 bg-slate-950/80">
      <SkillMatrix client:visible />
    </div>
  </div>
</section>
