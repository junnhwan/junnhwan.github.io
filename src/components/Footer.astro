---
const currentYear = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line py-9">
  <div
    class="max-w-3xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-5 text-[13px]"
  >
    <div class="flex flex-col items-center md:items-start gap-1">
      <div class="flex items-center gap-2 text-fg">
        <span class="font-medium">junnhwan</span>
        <span class="text-fg-subtle">·</span>
        <span class="text-fg-muted">Be here now</span>
      </div>
      <p class="text-[11px] text-fg-subtle">
        &copy; {currentYear} · Built with Astro
      </p>
    </div>

    <div class="flex flex-col items-center md:items-end gap-1.5 font-mono text-[11px]">
      <span id="runtime-text" class="text-fg-subtle tabular-nums"></span>
      <div class="flex items-center gap-3 text-fg-muted">
        <a
          href="https://github.com/junnhwan"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent transition-colors">GitHub</a
        >
        <span class="text-fg-subtle">·</span>
        <a href="/about" class="hover:text-accent transition-colors">About</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const SITE_START = new Date('2025-10-10T00:00:00+08:00');
  let timer: number | undefined;

  function renderRuntime() {
    const el = document.getElementById('runtime-text');
    if (!el) return;

    const diff = Date.now() - SITE_START.getTime();
    const days = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    const minutes = Math.floor((diff % 3600000) / 60000);

    el.textContent = `运行 ${days} 天 ${hours} 时 ${minutes} 分`;
  }

  function setupRuntime() {
    window.clearInterval(timer);
    renderRuntime();
    // Minute resolution: a ticking seconds counter is noise, not information.
    timer = window.setInterval(renderRuntime, 30000);
  }

  document.addEventListener('astro:page-load', setupRuntime);
</script>
