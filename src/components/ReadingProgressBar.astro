<div id="reading-progress-bar" class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-cyan-400 via-sky-400 to-blue-500 z-50 transition-all duration-75 w-0"></div>

<script>
  window.addEventListener('scroll', () => {
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    const scrollPos = window.scrollY;
    const progress = totalHeight > 0 ? (scrollPos / totalHeight) * 100 : 0;
    const bar = document.getElementById('reading-progress-bar');
    if (bar) {
      bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    }
  });
</script>
