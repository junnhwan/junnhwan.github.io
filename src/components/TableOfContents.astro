---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth > 1 && h.depth < 4);
---

{
  filteredHeadings.length > 0 && (
    <nav class="sticky top-24 rounded-2xl glass-card p-4 border border-white/5 bg-slate-950/70 text-xs max-h-[calc(100vh-120px)] overflow-y-auto">
      <div class="flex items-center gap-2 font-bold text-slate-200 mb-3 pb-2 border-b border-white/5">
        <svg xmlns="http://www.w3.org/2005/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-400">
          <line x1="21" y1="10" x2="3" y2="10"></line>
          <line x1="21" y1="6" x2="3" y2="6"></line>
          <line x1="21" y1="14" x2="3" y2="14"></line>
          <line x1="21" y1="18" x2="3" y2="18"></line>
        </svg>
        <span>目录导航 / TOC</span>
      </div>
      <ul class="space-y-1.5 text-slate-400">
        {filteredHeadings.map((h) => (
          <li
            class={`transition-colors hover:text-cyan-400 ${
              h.depth === 3 ? 'pl-3 text-[11px] text-slate-500' : 'font-medium'
            }`}
          >
            <a href={`#${h.slug}`} class="block py-0.5 truncate hover:underline">
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
