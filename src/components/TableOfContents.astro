---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth > 1 && h.depth < 4);
---

{
  items.length > 0 && (
    <nav class="sticky top-28" aria-label="目录">
      <div class="relative pl-4">
        {/* Rail plus a slider that tracks the active section */}
        <div class="absolute left-0 inset-y-0 w-px bg-line" />
        <div
          id="toc-indicator"
          class="absolute left-0 w-px bg-accent transition-all duration-[400ms]"
          style="top: 0; height: 0; opacity: 0;"
        />

        <ul class="space-y-2 max-h-[calc(100vh-11rem)] overflow-y-auto no-scrollbar">
          {items.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-slug={h.slug}
                class={`toc-link block text-[12px] leading-snug text-fg-subtle hover:text-fg transition-colors line-clamp-2 ${
                  h.depth === 3 ? 'pl-3' : ''
                }`}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

<script>
  let observer: IntersectionObserver | undefined;

  function setupToc() {
    observer?.disconnect();

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
    const indicator = document.getElementById('toc-indicator');
    if (!links.length || !indicator) return;

    const setActive = (slug: string) => {
      links.forEach((link) => {
        const active = link.dataset.slug === slug;
        link.classList.toggle('text-accent', active);
        link.classList.toggle('text-fg-subtle', !active);

        if (active) {
          indicator.style.top = `${link.offsetTop}px`;
          indicator.style.height = `${link.offsetHeight}px`;
          indicator.style.opacity = '1';
        }
      });
    };

    const visible = new Set<string>();

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          if (entry.isIntersecting) visible.add(id);
          else visible.delete(id);
        });

        // Pick the topmost heading currently inside the reading band.
        const first = links.find((link) => link.dataset.slug && visible.has(link.dataset.slug));
        if (first?.dataset.slug) setActive(first.dataset.slug);
      },
      { rootMargin: '-80px 0px -65% 0px' }
    );

    links.forEach((link) => {
      const target = link.dataset.slug ? document.getElementById(link.dataset.slug) : null;
      if (target) observer!.observe(target);
    });
  }

  document.addEventListener('astro:page-load', setupToc);
</script>
