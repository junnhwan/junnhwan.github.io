---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth > 1 && h.depth < 4);
---

{
  filteredHeadings.length > 0 && (
    <div class="sticky top-24 space-y-3">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider font-mono">
        目录 / TOC
      </p>
      <nav class="toc-container max-h-[calc(100vh-140px)] overflow-y-auto pr-2 text-xs space-y-1">
        {filteredHeadings.map((h) => (
          <a
            href={`#${h.slug}`}
            class={`toc-link block py-1 text-slate-400 hover:text-cyan-400 transition-colors truncate ${
              h.depth === 3 ? 'pl-3 text-[11px] text-slate-500' : 'font-medium'
            }`}
            data-slug={h.slug}
          >
            {h.text}
          </a>
        ))}
      </nav>
    </div>
  )
}

<script>
  function setupTocScrollSpy() {
    const links = document.querySelectorAll('.toc-link');
    if (!links.length) return;

    const headingEls: HTMLElement[] = [];
    links.forEach((link) => {
      const slug = link.getAttribute('data-slug');
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingEls.push(el);
      }
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            links.forEach((link) => {
              if (link.getAttribute('data-slug') === id) {
                link.classList.add('text-cyan-400', 'font-bold');
                link.classList.remove('text-slate-400', 'text-slate-500');
              } else {
                link.classList.remove('text-cyan-400', 'font-bold');
                if (link.classList.contains('pl-3')) {
                  link.classList.add('text-slate-500');
                } else {
                  link.classList.add('text-slate-400');
                }
              }
            });
          }
        });
      },
      {
        rootMargin: '0px 0px -70% 0px',
      }
    );

    headingEls.forEach((el) => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', setupTocScrollSpy);
  setupTocScrollSpy();
</script>
