---
---

<section class="relative pt-24 pb-8 overflow-hidden">
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-gradient-to-tr from-cyan-500/10 via-blue-600/5 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <!-- Left Content -->
      <div class="space-y-3">
        <div class="space-y-1">
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-sans">
            junnhwan
          </h1>
          <p class="text-sm font-mono text-cyan-400">
            Be here now.
          </p>
        </div>

        <p class="text-xs sm:text-sm text-slate-400 max-w-lg leading-relaxed">
          个人技术博客，记录学习笔记、后端开发与日常思考。
        </p>

        <!-- Links & Tags -->
        <div class="flex items-center gap-3 pt-2">
          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-cyan-500/15 hover:bg-cyan-500/25 text-cyan-300 font-medium text-xs border border-cyan-500/30 transition-all"
          >
            <span>浏览文章</span>
            <svg xmlns="http://www.w3.org/2005/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a
            href="https://github.com/junnhwan"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl glass-pill hover:bg-white/10 text-slate-300 hover:text-white text-xs border border-white/10 transition-all"
          >
            <svg xmlns="http://www.w3.org/2005/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
            <span>GitHub</span>
          </a>

          <a
            href="/about"
            class="inline-flex items-center gap-1 px-3 py-2 text-slate-400 hover:text-slate-200 text-xs transition-colors"
          >
            <span>关于我 →</span>
          </a>
        </div>
      </div>

      <!-- Right Logo / Geek Icon -->
      <div class="hidden sm:flex relative flex-shrink-0">
        <div class="w-20 h-20 rounded-2xl glass-card border border-white/10 flex items-center justify-center text-cyan-400 font-mono font-black text-xl shadow-lg">
          &lt;JH/&gt;
        </div>
      </div>
    </div>
  </div>
</section>
