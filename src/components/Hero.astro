---
import { HeroTyping } from './HeroTyping';
---

<section class="relative pt-24 pb-12 overflow-hidden">
  <!-- Radial Aura Effect -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[350px] bg-gradient-to-tr from-cyan-500/15 via-blue-600/10 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <!-- Left Content -->
      <div class="flex-1 space-y-5">
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full glass-pill border border-emerald-500/30 bg-emerald-950/30 text-emerald-300 text-xs font-mono shadow-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Focusing on AI Agent & Backend</span>
        </div>

        <!-- Main Title -->
        <div class="space-y-1">
          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-sans">
            Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-100 to-slate-400">junnhwan</span>
          </h1>
          <div class="text-lg sm:text-2xl font-medium text-slate-300 flex items-center gap-2 pt-1">
            <span>Building</span>
            <HeroTyping client:load />
          </div>
        </div>

        <!-- Description -->
        <p class="text-sm sm:text-base text-slate-400 leading-relaxed max-w-xl">
          热衷于将 <span class="text-cyan-300 font-medium">AI Agent (Tool Calling, Memory, Workflow)</span> 落地到实际场景，同时深耕 <span class="text-emerald-300 font-medium">Go / Java 高性能后端</span>。Be here now，记录每一次技术突破与实战复盘。
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-semibold text-xs tracking-wide shadow-[0_0_20px_rgba(0,242,254,0.3)] transition-all hover:scale-[1.02] active:scale-[0.98]"
          >
            <span>阅读文章</span>
            <svg xmlns="http://www.w3.org/2005/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a
            href="/projects"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl glass-pill hover:bg-white/10 text-slate-200 text-xs font-medium border border-white/10 hover:border-cyan-500/40 transition-all"
          >
            <svg xmlns="http://www.w3.org/2005/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-400">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>项目与开源</span>
          </a>

          <a
            href="https://github.com/junnhwan"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl glass-pill hover:bg-white/10 text-slate-300 text-xs font-medium border border-white/10 hover:border-white/20 transition-all"
          >
            <svg xmlns="http://www.w3.org/2005/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            </svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>

      <!-- Right Avatar / Aesthetic Card -->
      <div class="relative flex-shrink-0 group">
        <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-cyan-500 via-blue-500 to-emerald-500 opacity-40 blur-xl group-hover:opacity-75 transition-opacity duration-500"></div>
        <div class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-3xl p-1 bg-gradient-to-b from-white/20 to-white/5 backdrop-blur-xl border border-white/10 shadow-2xl overflow-hidden flex flex-col items-center justify-center">
          <div class="w-full h-full rounded-2xl bg-slate-900/90 flex flex-col items-center justify-center p-4 text-center">
            <!-- Geek Icon / Graphic -->
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-500/20 to-blue-600/20 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mb-2">
              <span class="font-mono font-black text-2xl tracking-tighter">&lt;JH/&gt;</span>
            </div>
            <span class="text-xs font-bold text-white tracking-wide">Junnhwan</span>
            <span class="text-[10px] text-slate-400 font-mono mt-0.5">@Shanghai, CN</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
